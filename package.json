{
  "name": "10mcj-bot",
  "private": true,
  "description": "Telegram bot for preparing 10 Minutes with Jesus messages and media.",
  "type": "commonjs",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "node build/app.js",
    "dev": "pnpm run build && concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"node --watch build/app.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run build:test && mocha --require reflect-metadata \"build-test/test/unit/domain/**/*.test.js\" \"build-test/test/unit/service/**/*.test.js\"",
    "test-repos": "pnpm run build:test && env-cmd -f .test.env -- mocha --require reflect-metadata \"build-test/test/**/repo/**/*.test.js\"",
    "test-services": "pnpm run build:test && mocha --require reflect-metadata \"build-test/test/unit/service/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.21.1",
    "botgram": "^2.2.0",
    "canvas": "^3.2.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "mongoose": "^9.12.1",
    "mp3-duration": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/randomstring": "^1.3.0",
    "concurrently": "^10.0.7",
    "env-cmd": "^11.0.0",
    "mocha": "^12.0.3",
    "randomstring": "^1.3.2",
    "typescript": "^7.0.2"
  }
}
