# Copy to .env for local development. Never put real credentials in this template.

# Required: create a development bot with @BotFather.
BOT_TOKEN=

# Required: numeric chat ID of the admin. Start a chat with your bot first.
ADMIN_CHAT_ID=

# Required: development restricts access to the admin and approved users.
# Allowed values: development, test, production.
RUNNING_ENV=development

# Required: MongoDB is the only supported option for all current bot features.
DB_TYPE=mongodb

# Required: local development database. Use a separate database for automated tests.
MONGODB_URL=mongodb://127.0.0.1:27017/10mcj-bot-dev

# Optional: HTTP image server port (defaults to 15000).
PORT=15000

# Optional: set a Telegram channel username (without @) to enable /pt_enviar.
# The bot must be allowed to post to that channel.
# CHANNEL=

# Optional: only used by the experimental video creation flow.
# FILESTACK_API_KEY=
# SHOTSTACK_API_KEY=
